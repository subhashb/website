---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Subhash Bhushan" description="The page you asked for is not here.">
  <div class="nf-shell">
    <header class="nf-header">
      <a class="nf-brand" href="/">subhashb.com</a>
    </header>
    <main class="nf">
      <p class="nf-eyebrow">Error 404</p>
      <h1 class="nf-title">Page not found.</h1>
      <p class="nf-body">The page you asked for is not here. It may have moved, or the address is wrong.</p>
      <p>
        <a class="nf-cta" href="/">Back home <span aria-hidden="true">&rarr;</span></a>
      </p>
    </main>
  </div>
</Base>

<style>
  .nf-shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 2.5rem);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .nf-header {
    padding: 0.25rem 0 clamp(2.5rem, 6vw, 4rem);
  }

  .nf-brand {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--color-muted);
  }
  .nf-brand:hover {
    color: var(--color-ink);
    text-decoration: none;
  }

  .nf {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: clamp(3rem, 8vw, 6rem);
  }

  .nf-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 clamp(1rem, 2vw, 1.5rem);
  }

  .nf-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 7.6vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
    max-width: 15ch;
    text-wrap: balance;
  }

  .nf-body {
    margin: clamp(1.25rem, 2.5vw, 1.75rem) 0 0;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.5;
    color: var(--color-muted);
    max-width: 42ch;
    text-wrap: pretty;
  }

  .nf-cta {
    display: inline-block;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>

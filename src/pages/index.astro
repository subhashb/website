---
import Base from '../layouts/Base.astro';
import ProteanConsole from '../components/ProteanConsole.astro';

const heroWords = [
  { t: 'I' },
  { t: 'design' },
  { t: 'and' },
  { t: 'build' },
  { t: 'ambitious', accent: true },
  { t: 'systems.', accent: true },
];

const buildingBlocks = ['Aggregates', 'Domain events', 'Repositories', 'Ports and adapters'];

const history = [
  {
    name: 'Team8 Solutions',
    facets: ['Co-founder', 'CTO and VP', 'Enterprise data and architecture at scale'],
    now: true,
  },
  {
    name: 'Ultimo Studios',
    facets: ['CTO', 'Engineering, product, and strategy', 'SOC 2 and ISO certified'],
    now: false,
  },
  {
    name: 'Kaybus',
    facets: ['Director of Engineering', 'Platform and business engineering', 'Through the acquisition'],
    now: false,
  },
  {
    name: 'JustBooks',
    facets: ['Co-founder', 'Built the platform end to end', 'One store to 63'],
    now: false,
  },
  {
    name: 'i-flex Solutions (Oracle)',
    facets: ['Technology Consultant', 'FLEXCUBE corporate banking', 'Worldwide pre-sales'],
    now: false,
  },
  {
    name: 'Logica (LogicaCMG)',
    facets: ['Associate Consultant', 'RBI RTGS core banking', 'Built from the ground up'],
    now: false,
  },
];

const writingTopics = [
  'Domain modeling',
  'AI-native building',
  'Software architecture',
  'Keeping large systems correct',
  'Team and craft',
  'Shipping to production',
];

const aboutFacts = [
  { label: 'Role', value: 'Co-founder, CTO and VP, Team8 Solutions' },
  { label: 'Advising', value: 'A global sustainability consultancy, at the CDO level' },
  { label: 'In the open', value: 'Protean' },
  { label: 'AI-native', value: 'An autonomous loop that ships to production behind quality gates' },
];

const links = [
  { label: 'Protean', display: 'proteanhq.com', href: 'https://proteanhq.com', icon: 'protean' },
  { label: 'Ambitious Systems', display: 'ambitious.systems', href: 'https://ambitious.systems', icon: 'A' },
  { label: 'GitHub', display: 'github.com/subhashb', href: 'https://github.com/subhashb', icon: 'github' },
  { label: 'LinkedIn', display: 'linkedin.com/in/subhashb', href: 'https://www.linkedin.com/in/subhashb', icon: 'linkedin' },
  { label: 'Email', display: 'subhash.bhushan@gmail.com', href: 'mailto:subhash.bhushan@gmail.com', icon: 'mail' },
];

const icons: Record<string, string> = {
  protean:
    '<svg width="20" height="20" viewBox="0 0 120 120" fill="none" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="7"><rect x="20" y="20" width="80" height="80" rx="28" opacity="0.3"/><rect x="26" y="26" width="68" height="68" rx="24" opacity="0.6" transform="rotate(15 60 60)"/><rect x="33" y="33" width="54" height="54" rx="19" opacity="0.9" transform="rotate(30 60 60)"/></g><rect x="45" y="45" width="30" height="30" rx="11" transform="rotate(45 60 60)" style="fill:var(--color-accent)"/></svg>',
  github:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"/></svg>',
  linkedin:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 110-4.13 2.06 2.06 0 010 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>',
  mail: '<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="M3.5 6.5 12 12.8l8.5-6.3"/></svg>',
};
---

<Base title="Subhash Bhushan">
  <div class="shell">
    <main>
      <section class="hero">
        <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
        <div class="hero__inner">
          <div class="hero__meta">
            <span class="eyebrow">Subhash Bhushan</span>
            <span class="hero__meta-right">
              <span class="hero__status">
                <span class="status-dot" aria-hidden="true"></span>
                <span data-hero-status>booting</span>
              </span>
              <button
                type="button"
                class="theme-toggle"
                data-theme-toggle
                aria-label="Toggle light or dark theme"
                title="Toggle light or dark"
              >
                <span data-seg="light">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9.2 18h5.6M10.2 20.8h3.6" style="stroke:var(--color-muted)" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.1 1.1 1.9l.1.8h4.8l.1-.8c.1-.8.5-1.4 1.1-1.9A6 6 0 0 0 12 3Z" style="fill:var(--color-accent)" />
                  </svg>
                </span>
                <span data-seg="dark">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M9.2 18h5.6M10.2 20.8h3.6" style="stroke:var(--color-muted)" stroke-width="1.5" stroke-linecap="round" />
                    <path d="M12 3a6 6 0 0 0-3.6 10.8c.6.5 1 1.1 1.1 1.9l.1.8h4.8l.1-.8c.1-.8.5-1.4 1.1-1.9A6 6 0 0 0 12 3Z" style="fill:none;stroke:var(--color-muted)" stroke-width="1.5" stroke-linejoin="round" />
                  </svg>
                </span>
              </button>
            </span>
          </div>
          <h1 class="hero__title">
            {
              heroWords.map((word, i) => (
                <>
                  <span
                    class={word.accent ? 'word word--accent' : 'word'}
                    style={`animation-delay:${(0.05 + i * 0.08).toFixed(2)}s`}
                  >
                    {word.t}
                  </span>{' '}
                </>
              ))
            }<span class="hero__cursor" data-hero-cursor aria-hidden="true"></span>
          </h1>
          <p class="hero__niche">Keeping large systems correct when the machine writes the code.</p>
          <div class="hero__copy">
            <p class="hero__lead">
              Large, complex software meant to grow, now built AI-natively on deep architecture and
              data foundations.
            </p>
            <p class="hero__sub">
              Architecture and domain-modeling depth, AI-native building at production speed, and the
              discipline to ship. I build Protean, the open-source framework that encodes how.
            </p>
          </div>
          <p class="hero__cta-wrap">
            <a href="#work" class="cta">See the work <span aria-hidden="true">&rarr;</span></a>
          </p>
        </div>
      </section>

      <section id="work" class="section">
        <div class="section-head">
          <span class="section-label">Open source</span>
          <span class="section-rule"></span>
          <a href="https://proteanhq.com" class="section-meta">
            proteanhq.com <span aria-hidden="true">&#8599;</span>
          </a>
        </div>

        <h2 class="work-heading">Protean</h2>

        <div class="work-body">
          <p class="work-desc">
            An open-source Python framework for large, domain-driven systems. It encodes the patterns
            that keep software correct as it grows: aggregates, domain events, and clean boundaries,
            so the domain model leads and infrastructure stays swappable.
          </p>
          <div class="blocks">
            <div class="blocks__label">Building blocks</div>
            <div class="blocks__list">
              {buildingBlocks.map((block) => <div class="blocks__item">{block}</div>)}
            </div>
          </div>
        </div>

        <ProteanConsole />
      </section>

      <section class="section">
        <div class="section-head">
          <span class="section-label">Track record</span>
          <span class="section-rule"></span>
        </div>
        <p class="record-intro">
          Twenty-three years shipping production software, from core banking to the platforms I run
          today.
        </p>
        <div class="record-list">
          {
            history.map((row) => (
              <div class="record-row">
                <div class="record-row__name-wrap">
                  <span class="record-name">{row.name}</span>
                  {row.now && <span class="record-tag">Present</span>}
                </div>
                <div class="record-facets">
                  {row.facets.map((facet, i) => (
                    <span class:list={['record-facet', i === 0 && 'record-facet--lead']}>{facet}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <span class="section-label">Writing</span>
          <span class="section-rule"></span>
          <a href="https://ambitious.systems" class="section-meta">
            ambitious.systems <span aria-hidden="true">&#8599;</span>
          </a>
        </div>
        <div class="writing">
          <div class="writing__main">
            <h2 class="writing__title">Ambitious Systems</h2>
            <p class="writing__body">
              When a machine writes most of the code, the scarce input is judgment: what to build, how
              to model the domain, and how to keep a large system correct as it grows.
            </p>
            <p class="writing__cta-wrap">
              <a href="https://ambitious.systems" class="writing__link">
                Read the essays <span aria-hidden="true">&#8599;</span>
              </a>
            </p>
          </div>
          <div class="writing__aside">
            <div class="writing__aside-label">What I write about</div>
            <div class="writing__list">
              {writingTopics.map((topic) => <div class="writing__list-item">{topic}</div>)}
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head">
          <span class="section-label">About</span>
          <span class="section-rule"></span>
        </div>
        <div class="about">
          <div class="about__main">
            <div class="portrait">
              <div class="portrait__frame">
                <img
                  src="/portrait.jpg"
                  alt="Subhash Bhushan"
                  width="458"
                  height="458"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
            <div class="about__intro">
              <p class="about__statement">I build large, complex software and the teams that run it.</p>
              <p class="about__sub">
                Twenty-three years of it, from core banking to the platforms I run today, working
                where the business decisions and the technology ones meet.
              </p>
            </div>
          </div>
          <div class="about__facts">
            <div class="facts">
              {
                aboutFacts.map((fact) => (
                  <div class="fact">
                    <div class="fact__label">{fact.label}</div>
                    <div class="fact__value">{fact.value}</div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-head section-head--tight">
          <span class="section-label">Elsewhere</span>
          <span class="section-rule"></span>
        </div>
        <div class="links">
          {
            links.map((link) => (
              <a href={link.href} class="link-row">
                <span class="link-row__left">
                  <span class="link-icon" aria-hidden="true">
                    {link.icon === 'A' ? (
                      <span class="link-monogram">{link.icon}</span>
                    ) : (
                      <Fragment set:html={icons[link.icon]} />
                    )}
                  </span>
                  <span class="link-label">{link.label}</span>
                </span>
                <span class="link-display">{link.display}</span>
              </a>
            ))
          }
          <div class="links__end"></div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <span>
        Built AI-natively with Astro. Source at
        <a href="https://github.com/subhashb/website">github.com/subhashb/website</a>.
      </span>
      <span>Subhash Bhushan</span>
    </footer>

    <div class="nav-hint" data-nav-hint aria-hidden="true">
      <span class="nav-hint__keys">&#8593;&#8595;</span>
      <span>jump between sections</span>
    </div>
  </div>
</Base>

<script>
  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Theme toggle. The stored choice wins; with none, the system preference does.
  const toggle = document.querySelector('[data-theme-toggle]');
  toggle?.addEventListener('click', () => {
    const explicit = root.getAttribute('data-theme');
    const current =
      explicit || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try {
      localStorage.setItem('theme', next);
    } catch (e) {}
  });

  // Hero boots, then goes live. Reduced motion skips straight to live.
  const statusEl = document.querySelector('[data-hero-status]');
  const cursorEl = document.querySelector('[data-hero-cursor]') as HTMLElement | null;
  const goLive = () => {
    if (statusEl) statusEl.textContent = 'live';
    if (cursorEl) cursorEl.style.display = 'none';
  };
  if (reduce) {
    goLive();
  } else {
    window.setTimeout(goLive, 1300);
  }

  // Keyboard section nav (j / k, PageDown / PageUp) with a dismissible hint.
  const hint = document.querySelector('[data-nav-hint]') as HTMLElement | null;
  const hideHint = () => {
    if (hint) hint.hidden = true;
  };
  const hintTimer = window.setTimeout(hideHint, 6000);

  const jump = (dir: number) => {
    const nodes = Array.from(document.querySelectorAll('main > section, footer'));
    if (!nodes.length) return;
    const tops = nodes.map((n) =>
      Math.max(0, Math.round(n.getBoundingClientRect().top + window.scrollY - 20)),
    );
    const cur = window.scrollY;
    const eps = 10;
    let curIdx = 0;
    for (let i = 0; i < tops.length; i++) {
      if (tops[i] <= cur + eps) curIdx = i;
      else break;
    }
    let ti;
    if (dir > 0) ti = Math.min(tops.length - 1, curIdx + 1);
    else ti = cur - tops[curIdx] > eps ? curIdx : Math.max(0, curIdx - 1);
    window.scrollTo({ top: tops[ti], behavior: reduce ? 'auto' : 'smooth' });
  };

  window.addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
    const target = e.target as HTMLElement | null;
    const tag = target?.tagName ?? '';
    if (tag === 'INPUT' || tag === 'TEXTAREA' || target?.isContentEditable) return;
    let dir = 0;
    if (e.key === 'PageDown' || e.key === 'j') dir = 1;
    else if (e.key === 'PageUp' || e.key === 'k') dir = -1;
    else return;
    e.preventDefault();
    window.clearTimeout(hintTimer);
    hideHint();
    jump(dir);
  });
  window.addEventListener('wheel', hideHint, { passive: true });
  window.addEventListener('touchmove', hideHint, { passive: true });

  // The hero dot field. A grid of dots, a slow idle wave, and a warm swell near
  // the pointer. It reads the resolved theme each frame, so the toggle recolors
  // it live. Reduced motion draws one static frame with no pointer tracking.
  const canvas = document.querySelector('[data-hero-canvas]') as HTMLCanvasElement | null;
  if (canvas) {
    const section = canvas.parentElement as HTMLElement;
    const mouse = { x: -9999, y: -9999 };
    let w = 0;
    let h = 0;
    let ctx: CanvasRenderingContext2D | null = null;

    const isDark = () => {
      const t = root.getAttribute('data-theme');
      if (t === 'dark') return true;
      if (t === 'light') return false;
      return window.matchMedia('(prefers-color-scheme: dark)').matches;
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(rect.width * dpr);
      canvas.height = Math.round(rect.height * dpr);
      ctx = canvas.getContext('2d');
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = (ts: number) => {
      if (!ctx) return;
      ctx.clearRect(0, 0, w, h);
      const dark = isDark();
      const gap = 28;
      const r0 = 1.05;
      const base = dark ? '239,233,223' : '28,24,19';
      const acc = dark ? '224,118,74' : '176,69,31';
      const t = ts / 1000;
      for (let y = gap / 2; y < h; y += gap) {
        for (let x = gap / 2; x < w; x += gap) {
          const dx = x - mouse.x;
          const dy = y - mouse.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const near = Math.max(0, 1 - dist / 150);
          const wave = 0.5 + 0.5 * Math.sin(t * 0.55 + x * 0.02 + y * 0.025);
          const idle = 0.05 + 0.05 * wave;
          if (near > 0.02) {
            ctx.fillStyle = 'rgba(' + acc + ',' + Math.min(0.92, idle + near * 0.9) + ')';
            ctx.beginPath();
            ctx.arc(x, y, r0 + near * 1.9, 0, 6.283);
            ctx.fill();
          } else {
            ctx.fillStyle = 'rgba(' + base + ',' + idle + ')';
            ctx.beginPath();
            ctx.arc(x, y, r0, 0, 6.283);
            ctx.fill();
          }
        }
      }
    };

    resize();
    window.addEventListener('resize', () => {
      resize();
      if (reduce) draw(0);
    });

    if (reduce) {
      draw(0);
    } else {
      section.addEventListener('pointermove', (e) => {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
      });
      section.addEventListener('pointerleave', () => {
        mouse.x = -9999;
        mouse.y = -9999;
      });
      const loop = (ts: number) => {
        draw(ts);
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>

<style>
  .shell {
    max-width: 1120px;
    margin: 0 auto;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(1.5rem, 4vw, 3rem) 0 clamp(3.5rem, 7vw, 5.5rem);
  }
  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    justify-content: space-between;
    margin: 0 0 clamp(1.5rem, 3vw, 2.25rem);
  }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .hero__meta-right {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
  }
  .hero__status {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--color-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: om-pulse 1.4s ease-in-out infinite;
  }
  .theme-toggle {
    width: 36px;
    height: 36px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: border-color 0.18s;
  }
  .theme-toggle:hover {
    border-color: var(--color-accent);
  }
  .theme-toggle svg {
    display: block;
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.6rem, 7.6vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin: 0;
    max-width: 15ch;
    text-wrap: balance;
  }
  .word {
    display: inline-block;
    opacity: 0;
    animation: om-word 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .word--accent {
    color: var(--color-accent-fill);
  }
  .hero__cursor {
    display: inline-block;
    width: 0.46em;
    height: 0.84em;
    margin-left: 0.08em;
    transform: translateY(0.08em);
    background: var(--color-accent);
    animation: om-blink 1s step-end infinite;
  }
  .hero__niche {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    margin: clamp(1.1rem, 2.4vw, 1.6rem) 0 0;
    max-width: 22ch;
    text-wrap: balance;
  }
  .hero__copy {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    margin: clamp(1.75rem, 3.5vw, 2.5rem) 0 0;
  }
  .hero__lead {
    flex: 1 1 320px;
    min-width: 0;
    font-weight: 500;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.42;
    color: var(--color-ink);
    margin: 0;
    text-wrap: pretty;
  }
  .hero__sub {
    flex: 1 1 320px;
    min-width: 0;
    font-weight: 400;
    font-size: clamp(1rem, 1.35vw, 1.12rem);
    line-height: 1.62;
    color: var(--color-muted);
    margin: 0;
    text-wrap: pretty;

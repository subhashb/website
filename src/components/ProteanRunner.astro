---
// A lazy, intent-gated runner. On click it loads Pyodide, installs Protean,
// and runs the snippet in the browser. If the runtime cannot start, the saved
// output stays and an honest note explains it. Nothing loads until the click.
const code = `from protean import Domain
from protean.fields import String, Integer

domain = Domain(name="Bookshop")

@domain.aggregate
class Book:
    title = String(required=True, max_length=200)
    copies = Integer(default=1)

book = Book(title="Domain-Driven Design", copies=3)
print(book.to_dict())`;

const savedOutput = "{'title': 'Domain-Driven Design', 'copies': 3, 'id': '...'}";
---

<figure class="mt-5 mb-0 rounded-md border border-line">
  <figcaption class="flex items-center justify-between gap-4 border-b border-line px-4 py-2 font-mono text-xs text-muted">
    <span>a domain model, running on Protean</span>
    <button type="button" data-run class="whitespace-nowrap text-accent">Run in your browser &rarr;</button>
  </figcaption>
  <pre class="overflow-x-auto px-4 py-3 font-mono text-[13px] leading-relaxed"><code data-code>{code}</code></pre>
  <div class="border-t border-line px-4 py-3 font-mono text-[13px] leading-relaxed">
    <span class="text-muted">output</span>
    <pre data-output class="mt-1 overflow-x-auto whitespace-pre-wrap">{savedOutput}</pre>
    <p data-note class="mt-2 text-xs text-muted"></p>
  </div>
</figure>

<script>
  const root = document.currentScript?.previousElementSibling;
  const btn = document.querySelector('[data-run]') as HTMLButtonElement | null;
  const codeEl = document.querySelector('[data-code]');
  const out = document.querySelector('[data-output]');
  const note = document.querySelector('[data-note]');
  let pyodide: any = null;

  btn?.addEventListener('click', async () => {
    if (!btn || !out || !note || !codeEl) return;
    const label = btn.textContent;
    btn.disabled = true;
    note.textContent = '';
    try {
      btn.textContent = 'Loading Python...';
      if (!pyodide) {
        const mod = await import(
          /* @vite-ignore */ 'https://cdn.jsdelivr.net/pyodide/v0.27.2/full/pyodide.mjs'
        );
        pyodide = await mod.loadPyodide();
        btn.textContent = 'Installing Protean...';
        await pyodide.loadPackage('micropip');
        const micropip = pyodide.pyimport('micropip');
        await micropip.install('protean');
      }
      btn.textContent = 'Running...';
      let captured = '';
      pyodide.setStdout({ batched: (s: string) => { captured += s + '\n'; } });
      await pyodide.runPythonAsync(codeEl.textContent || '');
      out.textContent = captured.trim() || '(no output)';
      note.textContent = 'Ran live in your browser via Pyodide.';
    } catch (err) {
      note.textContent = 'The live runner could not start here; the output above is from a saved run.';
    } finally {
      btn.textContent = label;
      btn.disabled = false;
    }
  });
</script>
